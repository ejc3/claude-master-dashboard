{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "claude-master-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // workers.dev is on now that Cloudflare Access covers the Worker (docs/deploy.md, step 3). Access
  // follows the Worker itself (an application with the Worker as its destination), so it gates
  // workers.dev and preview URLs alike once they are on. Wrangler applies these switches on each
  // deploy, so they change here and in ejc3/aws together.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The Access settings and the AWS key are Worker secrets (docs/deploy.md); they survive deploys.
  "env": {
    // The same build as claw-master-dashboard, the Worker's name after the rename (ejc3/aws#415).
    // No URL of its own until its own Access application covers it (a new Worker, a new id): with
    // no Access settings it admits nobody anyway. Its switches turn on here and in ejc3/aws together.
    "claw": {
      "name": "claw-master-dashboard",
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
