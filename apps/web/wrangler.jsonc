{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "claude-master-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Cloudflare Access gates every URL of this Worker (an Access application with a worker
  // destination). The app also refuses any request without a valid Access assertion, so a URL
  // that is up before the Access application exists shows nothing.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
  // CF_ACCESS_TEAM_DOMAIN, CF_ACCESS_AUD, DASHBOARD_ALLOWED_EMAILS and the AWS credentials are
  // Worker secrets set outside this repository (wrangler secret put); they survive deploys.
}
