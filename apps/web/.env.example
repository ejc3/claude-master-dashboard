# Copy to .env.local for local development. Real values live in the deployment's settings,
# never in this repository.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated addresses that may sign in.
DASHBOARD_ALLOWED_EMAILS=
# Optional: a 32+ character key that lets automated checks sign in as a read-only test user.
DASHBOARD_E2E_KEY=
# Local only: "off" skips sign-in outside production builds.
DASHBOARD_AUTH=
