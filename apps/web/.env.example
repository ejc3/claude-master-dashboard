# Copy to .env.local for local development only. Real values are Worker secrets (docs/deploy.md).
# OpenNext embeds .env files in a Worker built from this directory, so never put a secret here.
#
# Local only: "off" skips the Cloudflare Access check outside production builds.
DASHBOARD_AUTH=
# The Access team domain and this application's audience tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Optional: when set, only these addresses are admitted (narrows the Access policy).
DASHBOARD_ALLOWED_EMAILS=
# Optional: a service token client id admitted for automated checks.
DASHBOARD_SERVICE_TOKEN_CLIENT_ID=
